{
  "easycom": {
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path" : "pages/login/login",
      "style" :
      {
        "navigationBarTitleText" : "",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/tab/home/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/tab/list/index",
      "style": {
        "navigationBarTitleText": "列表"
      }
    },
    {
      "path": "pages/tab/user/index",
      "style": {
        "navigationStyle": "custom"
      },
      "needLogin": true
    },
    {
      "path" : "pages/register/register",
      "style" :
      {
         "navigationStyle": "custom"
      }
    },
    {
      "path" : "pages/chat/chat",
      "style" :
      {
         "navigationStyle": "custom"
        // "navigationBarTitleText" : "custom"
      }
    }

  ],
  "subPackages": [
    {
      "root": "pages/common",
      "pages": [
        {
          "path": "login/index",
          "style": {
            "navigationBarTitleText": "登录",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "webview/index",
          "style": {
            "navigationBarTitleText": "网页"
          }
        },
        {
          "path": "404/index",
          "style": {
            "navigationBarTitleText": "404",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "theme/index",
          "style": {
            "navigationBarTitleText": "主题设置"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/tab/home/index": {
      "network": "all",
      "packages": ["pages/common"]
    }
  },
  "tabBar": {
    "color": "#1b233b",
    "selectedColor": "#209fe4",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [{
      "iconPath": "static/images/tabbar/chat_unactive.png",
      "selectedIconPath": "static/images/tabbar/chat_active.png",
      "pagePath": "pages/chat/chat",
      "text": "对话"
    }, {
      "iconPath": "static/images/tabbar/create.png",
      "selectedIconPath": "static/images/tabbar/create_active.png",
      "pagePath": "pages/tab/list/index",
      "text": "创作"
    }, {
      "iconPath": "static/images/tabbar/history.png",
      "selectedIconPath": "static/images/tabbar/history_active.png",
      "pagePath": "pages/tab/user/index",
      "text": "历史"
    }]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "uni-app",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
