{
  "bsonType": "object",
  "required": ["conversation_id", "user_id", "role", "content", "create_time"],
  "permission": {
    "read": "auth.uid == doc.user_id", // 仅消息所属用户可读取
    "create": "auth != null", // 仅登录用户可创建
    "update": false, // 消息一旦创建不允许修改（按需调整）
    "delete": "auth.uid == doc.user_id" // 仅所属用户可删除
  },
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "消息唯一ID（云数据库自动生成）"
    },
    "conversation_id": {
      "bsonType": "string",
      "description": "关联对话ID（对应 conversation 表的 _id）",
      "index": true // 索引优化：查询对话内所有消息
    },
    "user_id": {
      "bsonType": "string",
      "description": "发送者ID（关联 user 表 _id 或 auth.uid，AI消息存系统用户ID）"
    },
    "role": {
      "bsonType": "int",
      "enum": [1, 2], // 1-用户，2-AI
      "description": "发送者角色：1-用户，2-AI"
    },
    "content": {
      "bsonType": "string",
      "maxLength": 2000, // 限制消息长度（按需调整）
      "description": "消息内容（文本，如用户提问、AI回复）"
    },
    "image_generate_flag": {
      "bsonType": "int",
      "defaultValue": 0,
      "enum": [0, 1], // 0-未触发，1-已触发
      "description": "是否触发生成图像：0-否，1-是"
    },
    "create_time": {
      "bsonType": "timestamp",
      "defaultValue": { "$env": "now" },
      "description": "消息发送时间（自动填充）"
    }
  },
  "description": "消息表（存储单条对话消息：用户提问/AI回复）"
}